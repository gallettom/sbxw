#!/usr/bin/env bash
# Idempotent, and never fails the container start: a failed step is
# reported and skipped. apt and pip are independent, so they run side
# by side; a restart with everything present runs neither.
set -uo pipefail
info() { echo "  [md-to-pdf-tools] $*"; }

# ── Startup marker ───────────────────────────────────────────────────
# Left when this script ends, however it ends, with the boot it ran in:
# how sbxw knows the install is over before it saves a template (a process
# list cannot tell "not started yet" from "finished"). Removed first, so a
# marker from an earlier start is never read as this one's.
SBXW_DONE="$HOME/.sbxw/startup/$(echo "$0" | tr / _).done"
mkdir -p "$HOME/.sbxw/startup" && rm -f "$SBXW_DONE"
trap 'cat /proc/sys/kernel/random/boot_id > "$SBXW_DONE" 2>/dev/null' EXIT

# ── The sbxw host cache ──────────────────────────────────────────────
# sbxw mounts ~/.sbxw/cache into the sandboxes it creates and
# names it in SBXW_CACHE: what was downloaded once (apt packages and
# lists, the Python wheels) is copied from there instead of fetched again.
# Only the sandbox sbxw's daemon fills it from (its own, which nobody
# works in) sees it writable, with SBXW_CACHE_FILL=1. printenv, not the
# variable: set -u, and no dollar-brace defaults in kit content.
CACHE=""; FILL=""
SBXW_CACHE="$(printenv SBXW_CACHE)"
if [ -n "$SBXW_CACHE" ] && [ -d "$SBXW_CACHE" ]; then
  CACHE="$SBXW_CACHE/$(dpkg --print-architecture 2>/dev/null)-$(. /etc/os-release 2>/dev/null; echo "$VERSION_CODENAME")"
  if [ "$(printenv SBXW_CACHE_FILL)" = 1 ]; then
    FILL=1; mkdir -p "$CACHE/apt/partial" "$CACHE/apt-lists" "$CACHE/wheels"
  fi
  [ -d "$CACHE" ] || CACHE=""
fi

# Another kit's startup may hold apt's lock at the same moment (sbx starts
# them side by side): wait for it rather than fail on it.
APT_WAIT="-o DPkg::Lock::Timeout=120"
# apt_install ARGS... — `apt-get install` that refreshes the package
# lists only when no kit has done so in the last hour (the stamp is
# shared with the other bundled kits), and once more if the install
# fails on lists that turned out to be stale.
APT_STAMP=/home/agent/.cache/sbxw-apt-updated
apt_update() {
  if [ "$1" != force ] && [ -n "$(find "$APT_STAMP" -mmin -60 2>/dev/null)" ]; then return 0; fi
  # Lists under a week old from the cache instead of the network.
  if [ "$1" != force ] && [ -z "$FILL" ] && [ -n "$CACHE" ] && [ -n "$(find "$CACHE/apt-lists/.stamp" -mmin -10080 2>/dev/null)" ] \
      && sudo cp "$CACHE"/apt-lists/*_* /var/lib/apt/lists/ 2>/dev/null; then
    mkdir -p "$(dirname "$APT_STAMP")" && touch "$APT_STAMP"; return 0
  fi
  sudo apt-get $APT_WAIT update -qq >/dev/null 2>&1 || return 1
  mkdir -p "$(dirname "$APT_STAMP")" && touch "$APT_STAMP"
  if [ -n "$FILL" ]; then
    find /var/lib/apt/lists -maxdepth 1 -type f -name '*_*' -exec cp {} "$CACHE/apt-lists/" \; 2>/dev/null
    touch "$CACHE/apt-lists/.stamp"
  fi
}
# Packages: the filling sandbox downloads into the cache; the others
# seed apt's own archive dir from it (apt checks each file's hash
# against the lists, and downloads whatever does not match).
apt_cache_opt() {
  if [ -n "$FILL" ]; then echo "-o Dir::Cache::Archives=$CACHE/apt"; return; fi
  [ -n "$CACHE" ] && sudo cp -n "$CACHE"/apt/*.deb /var/cache/apt/archives/ 2>/dev/null
  echo ""
}
apt_install() {
  apt_update fresh || return 1
  opt="$(apt_cache_opt)"
  sudo DEBIAN_FRONTEND=noninteractive apt-get $APT_WAIT install $opt -y -qq "$@" && return 0
  apt_update force && sudo DEBIAN_FRONTEND=noninteractive apt-get $APT_WAIT install $opt -y -qq "$@"
}

# ── 1. System libs (WeasyPrint's renderer + poppler's pdftoppm) ──────
# Checked by actual .so/binary presence, not package name: one package
# (libglib2.0-0t64 on Debian 13) carries several of these libraries.
NEED_LIBS=0
command -v pdftoppm >/dev/null 2>&1 || NEED_LIBS=1
# One ldconfig call, matched with `case`: `| grep -q` under pipefail
# can fail on SIGPIPE when grep quits at the first match.
LDCACHE="$(ldconfig -p 2>/dev/null)"
for lib in libpango-1.0.so.0 libpangoft2-1.0.so.0 libgobject-2.0.so.0 libglib-2.0.so.0; do
  case "$LDCACHE" in *"$lib"*) ;; *) NEED_LIBS=1 ;; esac
done

# ── 2. Python packages (Debian marks system Python externally-managed;
#    --break-system-packages confines nothing new since these are
#    pure-library installs the agent already runs as root/sudo user) ──
# Looked up with find_spec rather than imported: importing weasyprint
# alone takes the better part of a second, and finding the package is
# all the check needs (pip would not reinstall a broken one either).
# Plain space-separated string, not a bash array: kit spec.yaml content
# only allows the WORKDIR placeholder (in dollar-brace form), and bash
# array expansion syntax also needs dollar-brace, which the kit
# validator can't tell apart from a placeholder.
NEED_PIP="$(python3 -c '
from importlib.util import find_spec
print(" ".join(p for m, p in (("weasyprint", "weasyprint"), ("markdown", "markdown"), ("PIL", "pillow")) if find_spec(m) is None))
' 2>/dev/null)" || NEED_PIP="weasyprint markdown pillow"

PIP_PID=""
if [ -z "$NEED_PIP" ]; then
  info "python packages already installed"
else
  info "pip installing: $NEED_PIP"
  (
    # The cache first, for the filling sandbox too: a refill keeps the
    # wheels, so it only builds them when they are not there yet.
    from_cache() {
      [ -n "$CACHE" ] && pip3 install --break-system-packages -q --no-index --find-links "$CACHE/wheels" $NEED_PIP 2>/dev/null
    }
    if from_cache; then
      info "python packages installed from the sbxw cache"
    elif [ -n "$FILL" ] && pip3 wheel -q -w "$CACHE/wheels" $NEED_PIP >/dev/null 2>&1 && from_cache; then
      info "python packages installed, and their wheels left in the sbxw cache"
    elif pip3 install --break-system-packages -q $NEED_PIP; then
      info "python packages installed"
    else
      info "pip install failed — skipping (check network_allow for pypi)"
    fi
  ) &
  PIP_PID=$!
fi

if [ "$NEED_LIBS" -eq 0 ]; then
  info "system libs already installed"
else
  info "installing poppler-utils + pango/glib libs..."
  if apt_install poppler-utils libpango-1.0-0 libpangoft2-1.0-0 libglib2.0-0t64; then
    info "system libs installed"
  else
    info "apt-get install failed — skipping (check network_allow for apt mirrors)"
  fi
fi

[ -n "$PIP_PID" ] && wait "$PIP_PID"
[ -n "$FILL" ] && touch "$CACHE/.filled-md-to-pdf-tools"
info "done."
