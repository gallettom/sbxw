{
 "_": "The MCP credential header rule, shared by crates/core/src/mcp.rs (the authority), assets/js/mcp.js and the desktop (desktop/src/feat/mcp.rs, desktop/screens/mcp.luau). A name, lowercased, is split into words at every character that is not a letter or a digit. It carries a credential when one word is in `words`, or is `key` next to a word of `key_after` (before or after it). Such a header's value must hold a well-formed ${name} placeholder. `message` is the refusal, NAME replaced by the header name as typed.",
 "words": [
  "authorization",
  "auth",
  "authentication",
  "token",
  "secret",
  "password",
  "passwd",
  "credential",
  "credentials",
