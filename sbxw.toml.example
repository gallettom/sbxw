# sbxw.toml — drop this at the root of your project (e.g. the NEOS repo).
# All fields are optional; the values below are the built-in defaults.

# Host bind address for the browser terminal.
web_addr = "127.0.0.1:7681"

# The daemon's second listener: the only address sandboxes reach it on (their
# hooks, the relay, plan reports — each call carrying the sandbox's token). It
# must differ from web_addr: sandboxes are allowed this port, never the UI's.
agent_addr = "127.0.0.1:7682"

# Leave empty to attach the Claude agent (sbx run). Set to e.g. "bash" to open a
# shell inside the sandbox instead (sbx exec -it … bash).
web_shell = ""

# Plan written into the injected OAuth credentials (subscriptionType) when
# CLAUDE_CODE_OAUTH_TOKEN is used. Match your actual tier so the in-session
# label is correct: "pro", "max", "team", "enterprise", or "free".
claude_subscription = "pro"

# Model new sessions start on, passed as ANTHROPIC_DEFAULT_MODEL. Full model id
# ("claude-sonnet-5-5") or alias ("sonnet", "opus"). Empty => don't set it.
#
# A real default: it applies only when nothing else picks a model, so a /model
# chosen in-session now survives the next `sbxw up` instead of being overwritten.
# Needs Claude Code 2.1.236+ inside the sandbox (it comes from the sbx template,
# not from sbxw); on an older one the variable is ignored silently.
claude_model = "claude-sonnet-5-5"

# Models a thread can be started on — offered by New thread and named in a
# lead's plans, passed as `claude --model <id>`. A thread without one runs on
# claude_model.
models = [
  { id = "claude-sonnet-5-5", label = "Sonnet 5.5" },
  { id = "claude-opus-5-5", label = "Opus 5.5" },
  { id = "claude-haiku-5-5", label = "Haiku 5.5" },
]

# How the sandboxes sbxw creates see sbx's shared skill store (filled by
# `sbxw skills import`), passed as `sbx create --skills=…` (sbx 0.43+):
#   "off"        only what the sandbox's kits and workspace give it
#   "readonly"   the store, read-only — sbx's default
#   "readwrite"  the agent may add skills every other sandbox then mounts
# Empty leaves it to sbx (and its host-wide `skills.defaultMode`). The older
# `share_skills = false` still works and means "off".
# Read at CREATION only — changing it doesn't affect existing sandboxes.
skills = ""

# Image pull policy at creation, passed as `sbx create --pull=…`:
#   "always"   check the registry every time — sbx's default
#   "missing"  only pull an image the host doesn't have (faster, works offline,
#              but a newer template is not picked up by itself)
#   "never"    use what is on the host or fail
# Empty leaves it to sbx. Read at CREATION only.
pull = ""

# Keep the sandbox running with nobody attached (sbx 0.47's `sbx run -d`),
# until `sbxw stop`. Off, it stops by itself once idle — fine for an agent, not
# for a dev server you reach through the aliases below with no pane open.
# Applied at bring-up to a sandbox that is new or stopped; one already running
# is held up from its next start.
keep_running = false

# How many Claude sessions a sandbox may hold open at once in the web UI: the
# agent, plus each thread opened beside it with "+ Thread" (one git worktree
# and branch per thread). They share the sandbox's CPU and memory and your
# usage, so this is a budget. The agent itself is never refused.
max_agent_sessions = 4

# Command behind the web UI's Monitor pane, as argv (no shell involved).
# Bare `sbx` opens the CLI's own all-sandboxes dashboard. It runs on the HOST,
# outside every sandbox, which is why it is one fixed command and not a
# free-form box: the daemon listens on localhost and this is the whole of what
# the browser can start there. Set it to [] to drop the button entirely.
monitor_cmd = ["sbx"]

# One loopback IP per app => clean hostnames on their natural ports
# (http://neos.local:4200 actually binds 127.0.0.3:4200). On macOS this adds
# `ifconfig lo0 alias 127.0.0.X` (sudo). When false, everything shares 127.0.0.1.
ip_per_app = false

# Restrictive local-dev egress allowlist (applied via `sbx policy allow network`).
# It is intentionally NOT "**". Add what your toolchain needs.
network_allow = [
  "*.npmjs.org", "registry.npmjs.org", "*.yarnpkg.com",
  "pypi.org", "*.pythonhosted.org",
  "repo.packagist.org", "*.packagist.org", "getcomposer.org",
  "github.com", "*.githubusercontent.com", "codeload.github.com",
  "*.docker.io", "*.docker.com", "ghcr.io",
  "api.anthropic.com",
  # Uncomment if using the k8s-tools kit (exact domains the installers hit):
  # "dl.k8s.io", "cdn.dl.k8s.io",          # kubectl
  # "get.k3d.io", "raw.githubusercontent.com", "objects.githubusercontent.com",  # k3d
  # "storage.googleapis.com",              # skaffold
  # Uncomment for skaffold image builds / k3d cluster:
  # "quay.io", "*.quay.io",
  # Uncomment for the agent-skills kit (archify + brag): Chromium from the
  # Playwright CDN, ffmpeg and Chromium's libraries from the apt mirrors.
  # "cdn.playwright.dev", "playwright.download.prss.microsoft.com",
  # "deb.debian.org", "security.debian.org",
  # "archive.ubuntu.com", "security.ubuntu.com", "ports.ubuntu.com",
]

# Optional explicit denylist (applied via `sbx policy deny network`). Empty by
# default. Useful to carve exceptions out of a broad allow rule.
network_deny = []

# Files of KEY=VALUE lines handed to sbx as `--env-file`, in order.
# Relative paths resolve against THIS file's directory. sbx settles precedence
# itself: the [env] table below beats every file, and a later file beats an
# earlier one — sbxw merges nothing.
env_files = []

# ── Kits ──────────────────────────────────────────────────────────────────────
# Kits applied when the sandbox is created (`sbx create --kit`), the only
# moment sbx applies a kit whole. Adding one later means recreating the
# sandbox: `sbxw rm <name>` then `sbxw up <name>`.
#
# A kit reference is a DIRECTORY containing a spec.yaml (not a single .yaml),
# a .zip, an OCI ref (ghcr.io/org/kit:tag), or a git URL. Relative paths are
# resolved against this file's directory. Validate one with:
#   sbx kit validate <dir>
#
# IMPORTANT: `kits` (and all root keys) MUST come BEFORE the first [[ports]]
# table. In TOML, any key after [[ports]] belongs to that table, not the root,
# and would be silently ignored.
#
# The kits sbxw ships are named `sbxw:<name>` — no path to keep in sync, they
# are inside the binary. Without a `kits` line a sandbox gets the first three:
#   sbxw:codemap         /codemap: agents read (and write) a repo's code map in
#                        .sbxw-artifacts/codemap/ before reading its source.
#   sbxw:agent-skills    /archify, /brag, /i-have-adhd, /handoff, /grill-me,
#                        /frontend-design, pinned, with Chromium and ffmpeg.
#   sbxw:md-to-pdf-tools /md-to-pdf, with WeasyPrint and poppler.
#   sbxw:k8s-tools       kubectl + k3d + skaffold — opt-in, add it yourself.
# Each declares the egress it needs; nothing to add to network_allow.
# Writing `kits` replaces the defaults, so list them again to keep them:
#
# kits = [
#   "sbxw:codemap", "sbxw:agent-skills", "sbxw:md-to-pdf-tools",
#   "sbxw:k8s-tools",
#   "./my-kit",
# ]
# kits = []            # none at all

# Mount ~/.sbxw/cache read-only into new sandboxes: the bundled kits copy the
# apt packages, Chromium, skill tarballs and wheels from it instead of
# downloading them again. Filled once, in the background, by a throwaway
# sandbox (`sbxw cache` shows it, `sbxw cache warm --force` refreshes it).
# cache = true

# ── Environment variables ────────────────────────────────────────────────────
# Put variables in the sandbox: `sbx create -e KEY=VALUE` at creation (baked in,
# so every process sees them) and `sbx run -e` on every attach (so editing this
# and reopening the agent pane is enough — no recreate). A Bash pane is not the
# agent session, so it only ever sees the creation-time set.
#
# NOT for secrets. The value lands in `sbx create`'s argv (visible in the host's
# process list) and in a file most projects commit. Tokens belong in
# `sbx secret set` — which is how sbxw already handles the Anthropic one.
#
# IMPORTANT: `[env]` is a TOML *table*. Every root key above must come BEFORE
# it, exactly as with [[ports]] — a root key written after this line would be
# read as an environment variable instead.
#
# [env]
# NODE_ENV = "development"
# API_URL = "http://api.neos.local:8000"

# Apps to expose — none by default: a project without [[ports]] publishes
# nothing and adds no hostname (only sbxw.localhost, the web UI's own name).
# `sandbox_port` is what your dev server listens on INSIDE the sandbox —
# remember to bind it to 0.0.0.0 (ng serve --host 0.0.0.0). For example:
#
# [[ports]]
# alias = "neos.local"
# sandbox_port = 4200
# host_port = 4200
#
# [[ports]]
# alias = "api.neos.local"
# sandbox_port = 8000
# host_port = 8000
