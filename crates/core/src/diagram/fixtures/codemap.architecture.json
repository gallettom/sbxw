  "cards": [
    {
      "dot": "cyan",
      "title": "Spec v3 only",
      "items": [
        "sbx 0.51's claude is a v3 workload",
        "v1/v2 local kits refused before create"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stable paths",
      "items": [
        "sbx re-resolves a kit by path on every swap",
        "files rewritten only when bytes change"
      ]
    },
    {
      "dot": "rose",
      "title": "On the host",
      "items": [
        "secrets never enter a sandbox",
        "sbxw never answers an approval itself"
      ]
    },
    {
      "dot": "amber",
      "title": "Jarvis proposes",
      "items": [
        "the daemon writes, after a click",
        "high risk: never by voice"
      ]
    }
  ]
